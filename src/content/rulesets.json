        },
        "storage": {
          "food": 0.6
        }
      }
    },
    {
      "id": "lean_times",
      "name": "Lean Times",
      "blurb": "Halcyon has revised its exchange rate. Every batch and bounty pays half the scrip it used to. The forms are free.",
      "legacyMult": 1.2,
      "unlock": {
        "cycle": 1
      },
      "mods": {
        "scripIncome": 0.5
      }
    },
    {
      "id": "brownout",
