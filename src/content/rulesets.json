    {
      "id": "short_fuse",
      "name": "Short Fuse",
      "blurb": "Something about this site makes everything catch, crack or crawl. Incidents come far more often. The fire drills are mandatory.",
      "legacyMult": 1.25,
      "unlock": {
        "achievement": "incidents_50"
      },
      "mods": {
        "incidentRate": 1.75
      }
    },
    {
      "id": "no_radio",
      "name": "No Radio",
      "blurb": "The airwaves are dead and nobody wanders by. The founding party and their children are all the homestead will ever get.",
      "legacyMult": 1.4,
      "unlock": {
        "cycle": 2
      },
      "flags": [
        "noRadio"
      ]
    },
    {
      "id": "iron_door",
      "name": "Iron Door",
