{
  "name": "homestead",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/simulate.ts",
    "sprites": "python3 tools/sprites/build.py",
    "quest-balance": "vite-node scripts/questBalance.ts",
    "cap:sync": "cap sync",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:sync": "npm run build && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "lz-string": "^1.5.0",
    "pixi.js": "^8.21.0"
  }
}
